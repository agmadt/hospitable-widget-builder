# Public settings, baked into the build. Override in .env.local.
VITE_KIT_REPO=agmadt/hospitable-widgets
VITE_WIDGET_MAJOR=1
# The exact widget.js release the builder previews with.
VITE_WIDGET_VERSION=1.1.1
# Empty hides "Try the demo Worker". Set it to a Worker deployed with HOSPITABLE_PAT=dummy.
VITE_DEMO_WORKER=
