{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The builder: static files only, served at hospitable.adhityoagam.com/widgets.
  // Other paths on that hostname stay free for anything else.
  "name": "hospitable-widget-builder",
  "compatibility_date": "2026-10-15",
  "assets": { "directory": "./dist" },
  "routes": [{ "pattern": "hospitable.adhityoagam.com/widgets*", "zone_name": "adhityoagam.com" }]
}
