{
  "name": "hospitable-widget-builder",
  "private": true,
  "type": "module",
  "description": "Design a Hospitable listing widget, connect your Worker, copy the snippet.",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "sync-sample": "node scripts/sync-sample.mjs"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.3",
    "puppeteer-core": "^24.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
